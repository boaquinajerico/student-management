<!DOCTYPE html>
<html>
<head>
<title>Student Management</title>
<style>
  body {
    font-family: Arial, sans-serif;
    margin: 20px;
  }

  .tabs {
    display: flex;
    gap: 10px;
    margin: 20px 0;
    border-bottom: 1px solid #ddd;
    padding-bottom: 10px;
  }

  .tab {
    display: inline-block;
    padding: 10px 18px;
    text-decoration: none;
    color: #333;
    background: #f3f3f3;
    border: 1px solid #ddd;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    font-weight: bold;
  }

  .tab.active {
    background: #fff;
  }
</style>
</head>
<body>
<h1>Student Management System</h1>
<nav class="tabs">
  <a class="tab active" href="/students">Students</a>
  <a class="tab" href="/students/add">Add Student</a>
</nav>
<hr>
<h2>Student List</h2>
<table border="1" cellpadding="10">
<tr>
<th>ID</th>
<th>Student ID</th>
<th>Name</th>
<th>Course</th>
<th>Year</th>
<th>Email</th>
</tr>
<% students.forEach(student => { %>
<tr>
<td><%= student.id %></td>
<td><%= student.student_id %></td>
<td>
<%= student.first_name %>
<%= student.last_name %>
</td>
<td><%= student.course %></td>
<td><%= student.year_level %></td>
<td><%= student.email %></td>
</tr>
<% }); %>
</table>
</body>
</html>