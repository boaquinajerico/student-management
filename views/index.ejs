<!DOCTYPE html>
<html>
<head>
<title>Student Management</title>
<style>
  body {
    font-family: Arial, sans-serif;
    margin: 20px;
    background: #f5f7fb;
    color: #333;
  }

  h1, h2 {
    margin-bottom: 10px;
  }

  .tabs {
    display: flex;
    gap: 10px;
    margin: 20px 0;
    border-bottom: 1px solid #ddd;
    padding-bottom: 10px;
  }

  .tab {
    display: inline-block;
    padding: 10px 18px;
    text-decoration: none;
    color: #333;
    background: #f3f3f3;
    border: 1px solid #ddd;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    font-weight: bold;
  }

  .tab.active {
    background: #fff;
  }

  .search-form {
    margin: 20px 0;
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }

  .search-form input {
    padding: 8px 10px;
    width: 280px;
  }

  .search-form button,
  .action-btn,
  .delete-btn {
    padding: 8px 12px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    font-size: 14px;
  }

  .search-form button,
  .action-btn {
    background: #2563eb;
    color: white;
  }

  .delete-btn {
    background: #dc2626;
    color: white;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    background: white;
  }

  th, td {
    border: 1px solid #ddd;
    padding: 10px;
    text-align: left;
  }

  th {
    background: #e5e7eb;
  }

  .actions {
    display: flex;
    gap: 8px;
    align-items: center;
  }
</style>
</head>
<body>
<h1>Student Management System</h1>
<nav class="tabs">
  <a class="tab active" href="/students">Students</a>
  <a class="tab" href="/students/add">Add Student</a>
</nav>

<form class="search-form" action="/students/search" method="GET">
  <input type="text" name="keyword" placeholder="Search by student ID or name" value="<%= typeof keyword !== 'undefined' ? keyword : '' %>">
  <button type="submit">Search</button>
  <a class="action-btn" href="/students">Clear</a>
</form>

<h2>Student List</h2>
<table>
<tr>
<th>ID</th>
<th>Student ID</th>
<th>Name</th>
<th>Course</th>
<th>Year</th>
<th>Email</th>
<th>Action</th>
</tr>
<% if (students.length === 0) { %>
<tr>
  <td colspan="7">No students found.</td>
</tr>
<% } else { %>
<% students.forEach(student => { %>
<tr>
<td><%= student.id %></td>
<td><%= student.student_id %></td>
<td><%= student.first_name %> <%= student.last_name %></td>
<td><%= student.course %></td>
<td><%= student.year_level %></td>
<td><%= student.email %></td>
<td class="actions">
  <a class="action-btn" href="/students/<%= student.id %>/edit">Edit</a>
  <form action="/students/<%= student.id %>/delete" method="POST" style="display:inline; margin:0;">
    <button class="delete-btn" type="submit" onclick="return confirm('Delete this student?');">Delete</button>
  </form>
</td>
</tr>
<% }); %>
<% } %>
</table>
</body>
</html>